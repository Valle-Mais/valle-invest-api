# Copie para .env e preencha. A API não sobe sem as três primeiras.

# JSON da service account do Firebase, codificado em base64:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_CREDENTIALS_BASE64=

# Segredo do JWT. Mínimo 32 caracteres. Gere com:
#   openssl rand -base64 48
JWT_SECRET=

# Chave da API do Resend (envio de email).
RESEND_API_KEY=

# Remetente dos emails. Precisa ser de um domínio verificado no Resend.
# Sem definir, usa onboarding@resend.dev, que só entrega para a conta Resend.
MAIL_FROM=Valle Consultoria <acesso@seudominio.com.br>

# URL do front usada nos links de email (quando o request não informa origin).
FRONTEND_URL=http://localhost:4200

# Origens permitidas no CORS, separadas por vírgula.
FRONTEND_URLS=http://localhost:4200

PORT=3000
